# ---------------------------------------------------------------------------
# Which provider runs stage 2. Only stage 2 is affected: both providers are
# handed the same schema and prompts and return the same shape, so the rules
# and the decision are identical either way.
#   gemini    - Google Gemini (default)
#   anthropic - Claude
# ---------------------------------------------------------------------------
EXTRACTION_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Gemini. Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# api_key (default) sends the credential as `x-goog-api-key`; oauth sends it as
# a bearer token. Do not infer this from the key's prefix - AI Studio issues
# keys shaped like `AQ.Ab8...` that look like OAuth tokens but authenticate
# only as API keys. OAuth access tokens also expire roughly hourly.
GEMINI_AUTH_MODE=api_key

# Only used when GEMINI_AUTH_MODE=oauth: the project billed for the call.
# GEMINI_PROJECT=

# Optional. Gemini's reasoning dial: -1 for dynamic thinking, 0 to disable it
# where the model allows. Left unset because an unsupported value is a 400,
# not a warning.
# GEMINI_THINKING_BUDGET=

# ---------------------------------------------------------------------------
# Anthropic - only read when EXTRACTION_PROVIDER=anthropic.
# Get a key at https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# The model is an env var so it can be swapped without a code change. Leave it
# unset to get the default for the chosen provider (gemini-3.5-flash /
# claude-opus-5).
#
# On Gemini, note that the `*-pro` models are not available on the free tier at
# all - they return 429 with `limit: 0` rather than throttling - so a flash
# model is the one that works on an unbilled key.
# EXTRACTION_MODEL=gemini-3.5-flash

# low | medium | high | xhigh | max. Anthropic only. Invoice extraction is a
# reading task, not a reasoning-heavy one, so medium is the sweet spot. Raise it
# if a vendor layout defeats the model.
EXTRACTION_EFFORT=medium

# Ceiling on one extraction call, seconds.
REQUEST_TIMEOUT_S=180

# Where the SQLite DB lives
DB_PATH=data/invoices.db

# Server port
PORT=8000

# Artificial per-stage pacing, milliseconds. The pipeline runs faster than a
# human can watch, so this makes the live run view legible on video. Set to 0
# for honest throughput numbers.
STAGE_DELAY_MS=350

# ---------------------------------------------------------------------------
# Failover. Stage 2 walks this chain in order and, within each provider, every
# key configured for it. A spent free-tier key (HTTP 429) moves quietly to the
# next credential; when every one is exhausted the run fails with
# "extraction limit reached" rather than silently serving a fixture.
# ---------------------------------------------------------------------------
EXTRACTION_CHAIN=gemini,groq,anthropic

# Backup credentials. Either numbered spares (shown here) or a comma-separated
# list in the primary variable (GEMINI_API_KEY=first,second) works.
# GEMINI_API_KEY_2=
# GROQ_API_KEY_2=
