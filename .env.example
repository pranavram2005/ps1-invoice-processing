# ---------------------------------------------------------------------------
# Anthropic - the extraction model. Get a key at https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# The model is an env var so it can be swapped without a code change.
# claude-sonnet-5 is ~2.5x cheaper per token and also competent at this task.
EXTRACTION_MODEL=claude-opus-5

# low | medium | high | xhigh | max. Invoice extraction is a reading task, not a
# reasoning-heavy one, so medium is the sweet spot. Raise it if a vendor layout
# defeats the model.
EXTRACTION_EFFORT=medium

# Where the SQLite DB lives
DB_PATH=data/invoices.db

# Server port
PORT=8000

# Artificial per-stage pacing, milliseconds. The pipeline runs faster than a
# human can watch, so this makes the live run view legible on video. Set to 0
# for honest throughput numbers.
STAGE_DELAY_MS=350
